import dearpygui.dearpygui as dpg
import random
import time
import threading
# Constants
DURATION = 3.0  # Seconds to display
UPDATE_RATE = 0.05  # Update interval (20 FPS)
BUFFER_SIZE = int(DURATION / UPDATE_RATE)  # Number of points in buffer
# Initialize data buffers
x_data = [i * UPDATE_RATE for i in range(BUFFER_SIZE)]  # X-axis (time)
y_data = [0] * BUFFER_SIZE  # Y-axis (signal)
class DataGenerator:
    def __init__(self):
        self.value = 0
        self.lock = threading.Lock()  # Add a lock for thread safety
        self.running = True  # Flag to stop thread gracefully
    def generate_data(self):
        while self.running:
            new_value = random.uniform(-1, 1)  # Simulated sensor data
            with self.lock:  # Ensure thread-safe update
                self.value = new_value
    def get_value(self):
        with self.lock:  # Ensure thread-safe read
            return self.value
    def stop(self):
        self.running = False

data_source = DataGenerator()
data_thread = threading.Thread(target=data_source.generate_data, daemon=True)
data_thread.start()





def update_plot(sender, app_data):
    new_value = data_source.get_value()  # Fetch latest data
    # Shift the data left to create a scrolling effect
    y_data.append(new_value)
    y_data.pop(0)
    # Update the plot
    dpg.set_value("plot_series", [x_data, y_data])



dpg.create_context()
with dpg.window(label="Current", width=700, height=500):
    with dpg.plot(label="Actual_Current", height=300, width=600):
        dpg.add_plot_axis(dpg.mvXAxis, label="Time (s)", tag="x_axis")
        with dpg.plot_axis(dpg.mvYAxis, label="I", tag="y_axis"):
            dpg.add_line_series(x_data, y_data, label="Waveform", tag="plot_series")

# dpg.set_frame_callback(1, update_plot)
dpg.create_viewport(title="Motor_Controller", width=700, height=500)
dpg.setup_dearpygui()
dpg.show_viewport()
# Continuously update the plot every frame
while dpg.is_dearpygui_running():
    update_plot(None, None)  # Call update function
    dpg.render_dearpygui_frame()
dpg.destroy_context()